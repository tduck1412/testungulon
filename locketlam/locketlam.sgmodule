#!url=https://raw.githubusercontent.com/tduck1412/testungulon/main/locketlam.sgmodule
#!name=Locket Gold VIP - tduc
#!desc=Mở khóa Locket Gold VIP vĩnh viễn (RevenueCat + Firebase Remote Config). Phát hành bởi tduc (https://www.facebook.com/tduck.2007/).
#!author=tduc
#!icon=https://raw.githubusercontent.com/tduck1412/testungulon/main/assets/img/shadowrocket.webp

[Script]
# Mở khóa gói Locket Gold qua RevenueCat (Bản mã hóa bảo vệ)
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/tduck1412/testungulon/main/locketlam/locketlam.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag header để luôn nhận phản hồi mới từ RevenueCat (Bản mã hóa bảo vệ)
deleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tduck1412/testungulon/main/locketlam/deleteHeader.js, timeout=60

# Mở khóa toàn bộ Remote Config (Bản mã hóa bảo vệ)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/tduck1412/testungulon/main/locketlam/locket_remote.js, requires-body=true, max-size=-1, timeout=60

# Giả lập vùng Hoa Kỳ (US) & App Storefront cho Remote Config để kích hoạt AR Filters
locket_rc_us = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch, script-path=https://raw.githubusercontent.com/tduck1412/testungulon/main/locketlam/Locket_rc_us.js, requires-body=true, max-size=-1, timeout=60

# Giữ Huy hiệu Locket Gold luôn BẬT và đồng bộ thông tin tài khoản (Bản mã hóa bảo vệ)
locket_badge = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://raw.githubusercontent.com/tduck1412/testungulon/main/locketlam/locket_profile.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com

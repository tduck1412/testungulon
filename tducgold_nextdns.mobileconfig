<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>Locket Gold DNS 2 - NextDNS Backup (tduc) 💛</string>

	<key>PayloadDescription</key>
	<string>DNS 2 Chống thu hồi Locket Gold vĩnh viễn dự phòng chạy trên NextDNS riêng của tduc (ID: a2dd89 - fb.com/tduck.2007). Dùng để phân tải hoặc thay thế khi cần.</string>

	<key>PayloadIdentifier</key>
	<string>com.tduc.locketgold.dns.nextdns.profile</string>

	<key>PayloadOrganization</key>
	<string>tduc (fb.com/tduck.2007)</string>

	<key>PayloadScope</key>
	<string>System</string>

	<key>PayloadType</key>
	<string>Configuration</string>

	<key>PayloadUUID</key>
	<string>3C6C2652-9FA8-4D48-9F55-52B19F0D24B1</string>

	<key>PayloadVersion</key>
	<integer>1</integer>

	<key>PayloadContent</key>
	<array>
		<!-- 1. HỒ SƠ SPLIT DNS (DoH) NEXTDNS DỰ PHÒNG CỦA TDUC -->
		<dict>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>

				<!-- Máy chủ DoH NextDNS riêng của @tduc (ID: a2dd89) -->
				<key>ServerURL</key>
				<string>https://apple.dns.nextdns.io/a2dd89/TducGold</string>

				<!-- IP Anycast NextDNS -->
				<key>ServerAddresses</key>
				<array>
					<string>45.90.28.0</string>
					<string>45.90.30.0</string>
					<string>2a07:a8c0::</string>
					<string>2a07:a8c1::</string>
				</array>

				<!-- SPLIT DNS: Chỉ định tuyến các domain này qua NextDNS, mạng khác vẫn dùng mạng gốc -->
				<key>SupplementalMatchDomains</key>
				<array>
					<!-- RevenueCat: Hệ thống kiểm tra và thu hồi Gold -->
					<string>revenuecat.com</string>
					<string>api.revenuecat.com</string>
					<string>app.revenuecat.com</string>
					<string>www.revenuecat.com</string>
					<string>purchases.revenuecat.com</string>
					<string>sdk.revenuecat.com</string>
					<string>backend.revenuecat.com</string>

					<!-- Telemetry & Analytics: Chặn theo dõi và gửi log hành vi người dùng -->
					<string>in.appcenter.ms</string>
					<string>app-measurement.com</string>
					<string>mixpanel.com</string>
					<string>api.mixpanel.com</string>
					<string>firebaselogging-pa.googleapis.com</string>
					<string>firebaselogging.googleapis.com</string>
					<string>ingest.sentry.io</string>
					<string>api2.amplitude.com</string>
					<string>appsflyersdk.com</string>
					<string>oy24bn.skadsdkless.appsflyersdk.com</string>

					<!-- Chống thu hồi chứng chỉ Apple (ESign, Scarlet, GBox, TrollStore, IPA Doanh Nghiệp) -->
					<string>certs.apple.com</string>
					<string>certs.apple.com.edgekey.net</string>
					<string>crl.apple.com</string>
					<string>crl.apple.com.akadns.net</string>
					<string>crl.apple.com.edgekey.net</string>
					<string>crl.entrust.net</string>
					<string>crl3.digicert.com</string>
					<string>crl4.digicert.com</string>
					<string>ocsp-lb.apple.com.akadns.net</string>
					<string>ocsp.apple.com</string>
					<string>ocsp.apple.com.edgekey.net</string>
					<string>ocsp.digicert.cn</string>
					<string>ocsp.digicert.com</string>
					<string>ocsp2.apple.com</string>
					<string>ocsp2.apple.com.edgekey.net</string>
					<string>valid.apple.com</string>
					<string>valid.apple.com.akadns.net</string>
					<string>valid.apple.com.edgekey.net</string>
					<string>ppq.apple.com</string>
					<string>iadsdk.apple.com</string>
				</array>
			</dict>

			<!-- Tự động xử lý Captive Portal WiFi công cộng không bị kẹt -->
			<key>OnDemandRules</key>
			<array>
				<dict>
					<key>Action</key>
					<string>EvaluateConnection</string>
					<key>ActionParameters</key>
					<array>
						<dict>
							<key>DomainAction</key>
							<string>NeverConnect</string>
							<key>Domains</key>
							<array>
								<string>captive.apple.com</string>
								<string>3gppnetwork.org</string>
								<string>dav.orange.fr</string>
								<string>vvm.mobistar.be</string>
								<string>vvm.mstore.msg.t-mobile.com</string>
								<string>tma.vvm.mone.pan-net.eu</string>
								<string>vvm.ee.co.uk</string>
							</array>
						</dict>
					</array>
				</dict>
				<dict>
					<key>Action</key>
					<string>Connect</string>
				</dict>
			</array>

			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadIdentifier</key>
			<string>com.tduc.locketgold.dns.nextdns.managed</string>
			<key>PayloadUUID</key>
			<string>62F0D8E9-2182-4E38-9844-3B9B3BC03417</string>
			<key>PayloadDisplayName</key>
			<string>NextDNS TducGold Engine (a2dd89)</string>
			<key>PayloadDescription</key>
			<string>Hồ sơ NextDNS dự phòng chống thu hồi Locket Gold.</string>
			<key>PayloadOrganization</key>
			<string>Tduc Dev (@tduc)</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>

		<!-- 2. QUYỀN TRỢ NĂNG DOANH NGHIỆP (CHO PHÉP TIN CẬY & CÀI PROFILE MƯỢT MÀ) -->
		<dict>
			<key>AllowEnterpriseAppInstallation</key>
			<true/>
			<key>allowAppInstallation</key>
			<true/>
			<key>AllowEnterpriseAppTrust</key>
			<true/>
			<key>allowEnterpriseAppTrust</key>
			<true/>
			<key>allowOpenFromManagedToUnmanaged</key>
			<true/>
			<key>allowOpenFromUnmanagedToManaged</key>
			<true/>
			<key>allowUntrustedTLSPrompt</key>
			<true/>
			<key>allowUIConfigurationProfileInstallation</key>
			<true/>
			<key>PayloadDisplayName</key>
			<string>Enterprise App Restrictions</string>
			<key>PayloadIdentifier</key>
			<string>com.tduc.enterprise.restrictions.backup</string>
			<key>PayloadType</key>
			<string>com.apple.applicationaccess</string>
			<key>PayloadUUID</key>
			<string>6E8B24F1-93C7-4D50-A6E2-18F9B3C75D04</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>

	<key>PayloadRemovalDisallowed</key>
	<false/>
</dict>
</plist>

